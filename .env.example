# Database (SQLite by default for zero-config local dev; swap to a Postgres URL in prod)
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Anthropic API — powers the Connections Engine, Question Assist, and image OCR/description.
# The app works without it (AI sections just show "unavailable"), but the core value prop needs it.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"
