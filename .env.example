# Database — Postgres (required; Vercel's serverless functions have no persistent
# disk, so this can't be SQLite in production). Vercel Postgres, Neon, and Supabase
# all give you a connection string in this shape. A local Postgres works for dev too.
DATABASE_URL="postgresql://user:password@localhost:5432/zettel"

# NextAuth
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Anthropic API — powers the Connections Engine, Question Assist, and image OCR/description.
# The app works without it (AI sections just show "unavailable"), but the core value prop needs it.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# Image storage. Local dev falls back to the filesystem (public/uploads) automatically
# when this is unset. In production (Vercel), set this — Vercel's filesystem is
# read-only/ephemeral, so local storage silently loses every uploaded image.
# Create a store under Vercel > Storage > Blob and it fills this in for you.
BLOB_READ_WRITE_TOKEN=""
